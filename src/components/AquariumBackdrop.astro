---
import { existsSync, readdirSync } from "node:fs";
import { extname, resolve } from "node:path";
import { withBase } from "../lib/paths.js";

// These directories are the single source of truth for aquarium artwork. The
// CMS manages their files through Media, without duplicating them in Site Settings.
const sceneryBackgroundDirectory = resolve(process.cwd(), "public", "backgrounds");
const fishBackgroundDirectory = resolve(process.cwd(), "public", "backgrounds", "fish");
const supportedBackgroundExtensions = new Set([".avif", ".jpg", ".jpeg", ".png", ".svg", ".webp"]);
const publicBackgroundUrls = (directory, publicPath) =>
  existsSync(directory)
    ? readdirSync(directory, { withFileTypes: true })
        .filter(
          (entry) =>
            entry.isFile() && supportedBackgroundExtensions.has(extname(entry.name).toLowerCase()),
        )
        .map((entry) => withBase(`${publicPath}/${entry.name}`))
        .sort()
    : [];

const availableSceneryImages = publicBackgroundUrls(sceneryBackgroundDirectory, "backgrounds");
const availableFishBackgroundImages = publicBackgroundUrls(fishBackgroundDirectory, "backgrounds/fish");
const hasFishBackgroundImages = availableFishBackgroundImages.length > 0;
const initialLeftScenery = availableSceneryImages[0] ?? null;
const initialRightScenery = availableSceneryImages[1] ?? initialLeftScenery;
const initialLeftFish = availableFishBackgroundImages[0] ?? null;
const initialRightFish = availableFishBackgroundImages[1] ?? initialLeftFish;
---

<div
  class:list={{
    "aquarium-backdrop": true,
    "has-fish-backgrounds": hasFishBackgroundImages,
  }}
  aria-hidden="true"
  data-aquarium-backdrop
>
  {initialLeftScenery && (
    <div
      class="aquarium-scenery-layer aquarium-backdrop-left"
      data-aquarium-backdrop-left
      style={`background-image: url("${initialLeftScenery}")`}
    ></div>
  )}
  {initialRightScenery && (
    <div
      class="aquarium-scenery-layer aquarium-backdrop-right"
      data-aquarium-backdrop-right
      style={`background-image: url("${initialRightScenery}")`}
    ></div>
  )}
  {initialLeftFish && (
    <div
      class="aquarium-fish-layer aquarium-fish-left"
      data-aquarium-fish-left
      style={`background-image: url("${initialLeftFish}")`}
    ></div>
  )}
  {initialRightFish && (
    <div
      class="aquarium-fish-layer aquarium-fish-right"
      data-aquarium-fish-right
      style={`background-image: url("${initialRightFish}")`}
    ></div>
  )}
</div>

<script is:inline define:vars={{
  availableSceneryImages,
  availableFishBackgroundImages,
}}>
  (() => {
    const backdrop = document.querySelector("[data-aquarium-backdrop]");
    const leftBackdrop = document.querySelector("[data-aquarium-backdrop-left]");
    const rightBackdrop = document.querySelector("[data-aquarium-backdrop-right]");
    const leftFishBackdrop = document.querySelector("[data-aquarium-fish-left]");
    const rightFishBackdrop = document.querySelector("[data-aquarium-fish-right]");

    if (!backdrop) {
      return;
    }

    const selectPair = (images) => {
      const leftIndex = Math.floor(Math.random() * images.length);
      const rightIndex =
        images.length > 1
          ? (leftIndex + 1 + Math.floor(Math.random() * (images.length - 1))) % images.length
          : leftIndex;

      return [images[leftIndex], images[rightIndex]];
    };

    const randomizeOrientation = (element) => {
      element?.classList.toggle("is-mirrored", Math.random() < 0.5);
    };

    if (leftBackdrop && rightBackdrop && availableSceneryImages.length) {
      const [leftScenery, rightScenery] = selectPair(availableSceneryImages);
      leftBackdrop.style.backgroundImage = `url("${leftScenery}")`;
      rightBackdrop.style.backgroundImage = `url("${rightScenery}")`;
      randomizeOrientation(leftBackdrop);
      randomizeOrientation(rightBackdrop);
    }

    if (leftFishBackdrop && availableFishBackgroundImages.length) {
      const [leftFish, rightFish] = selectPair(availableFishBackgroundImages);
      leftFishBackdrop.style.backgroundImage = `url("${leftFish}")`;
      randomizeOrientation(leftFishBackdrop);

      if (rightFishBackdrop && availableFishBackgroundImages.length > 1) {
        rightFishBackdrop.style.backgroundImage = `url("${rightFish}")`;
        randomizeOrientation(rightFishBackdrop);
      }
    }

    const updateArtworkSize = () => {
      const contentFrame = document.querySelector(".page-wrap");
      const footer = document.querySelector(".site-footer");
      const sideSpace = Math.max(
        0,
        contentFrame?.getBoundingClientRect().left ?? window.innerWidth / 2,
      );
      const artworkWidth = Math.min(900, Math.max(460, Math.round(sideSpace)));
      const footerClearance = Math.ceil(footer?.getBoundingClientRect().height ?? 0);
      backdrop.style.setProperty("--aquarium-art-width", `${artworkWidth}px`);
      backdrop.style.setProperty("--aquarium-footer-clearance", `${footerClearance}px`);
    };

    window.addEventListener("resize", updateArtworkSize, { passive: true });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", updateArtworkSize, { once: true });
    } else {
      updateArtworkSize();
    }

  })();
</script>
