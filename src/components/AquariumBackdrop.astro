---
import { existsSync, readdirSync } from "node:fs";
import { extname } from "node:path";
import { fileURLToPath } from "node:url";
import { withBase } from "../lib/paths.js";

const fallbackImageNames = [
  "aquarium-01-planted-driftwood.svg",
  "aquarium-02-sunken-treasure.svg",
  "aquarium-04-slate-cave.svg",
  "aquarium-05-shipwreck.svg",
  "aquarium-06-stone-lantern.svg",
  "aquarium-07-terracotta-nursery.svg",
  "aquarium-08-classical-ruins.svg",
  "aquarium-09-hollow-log.svg",
  "aquarium-10-diving-helmet.svg",
  "aquarium-11-bubbler-submarine.svg",
  "aquarium-12-planted-bridge.svg",
  "aquarium-13-rooted-riverbank.svg",
  "aquarium-14-vallisneria-meadow.svg",
  "aquarium-15-red-stem-garden.svg",
  "aquarium-16-branching-spiderwood.svg",
  "aquarium-17-rounded-riverbed.svg",
  "aquarium-18-amazon-sword-grove.svg",
  "aquarium-19-mossy-driftwood-bank.svg",
  "aquarium-20-blackwater-roots.svg",
  "aquarium-21-cryptocoryne-thicket.svg",
  "aquarium-22-tiger-lotus-garden.svg",
  "aquarium-23-seiryu-stone-ridge.svg",
];
const fallbackImages = fallbackImageNames.map((filename) => withBase(`backgrounds/${filename}`));
const sceneryCmsImages = Array.isArray(Astro.props.images) ? Astro.props.images : [];
const fishCmsImages = Array.isArray(Astro.props.fishImages) ? Astro.props.fishImages : [];
const sandCmsImages = Array.isArray(Astro.props.sandImages) ? Astro.props.sandImages : [];
const normalizeBackgroundImage = (value, directory) => {
  const normalized = String(value ?? "")
    .trim()
    .replace(/^\/+/, "")
    .replace(/^public\//i, "");
  const path = normalized.startsWith(`${directory}/`)
    ? normalized
    : `${directory}/${normalized}`;

  return withBase(path);
};
const sceneryImages = sceneryCmsImages
  .map((value) => normalizeBackgroundImage(value, "backgrounds"))
  .filter(Boolean);
const configuredFishBackgroundImages = fishCmsImages
  .map((value) => normalizeBackgroundImage(value, "fish-backgrounds"))
  .filter(Boolean);
const configuredSandBackgroundImages = sandCmsImages
  .map((value) => normalizeBackgroundImage(value, "sand-backgrounds"))
  .filter(Boolean);
const fishBackgroundDirectory = fileURLToPath(
  new URL("../../public/fish-backgrounds/", import.meta.url),
);
const sandBackgroundDirectory = fileURLToPath(
  new URL("../../public/sand-backgrounds/", import.meta.url),
);
const supportedBackgroundExtensions = new Set([".avif", ".jpg", ".jpeg", ".png", ".svg", ".webp"]);
const uploadedFishBackgroundImages = existsSync(fishBackgroundDirectory)
  ? readdirSync(fishBackgroundDirectory, { withFileTypes: true })
      .filter(
        (entry) =>
          entry.isFile() && supportedBackgroundExtensions.has(extname(entry.name).toLowerCase()),
      )
      .map((entry) => withBase(`fish-backgrounds/${entry.name}`))
      .sort()
  : [];
const uploadedSandBackgroundImages = existsSync(sandBackgroundDirectory)
  ? readdirSync(sandBackgroundDirectory, { withFileTypes: true })
      .filter(
        (entry) =>
          entry.isFile() && supportedBackgroundExtensions.has(extname(entry.name).toLowerCase()),
      )
      .map((entry) => withBase(`sand-backgrounds/${entry.name}`))
      .sort()
  : [];
const availableSceneryImages = sceneryImages.length ? sceneryImages : fallbackImages;
const availableFishBackgroundImages = configuredFishBackgroundImages.length
  ? configuredFishBackgroundImages
  : uploadedFishBackgroundImages;
const availableSandBackgroundImages = configuredSandBackgroundImages.length
  ? configuredSandBackgroundImages
  : uploadedSandBackgroundImages;
const hasFishBackgroundImages = availableFishBackgroundImages.length > 0;
const hasSandBackgroundImages = availableSandBackgroundImages.length > 0;
const initialLeftScenery = availableSceneryImages[0];
const initialRightScenery = availableSceneryImages[1] ?? initialLeftScenery;
const initialLeftFish = availableFishBackgroundImages[0] ?? null;
const initialRightFish = availableFishBackgroundImages[1] ?? initialLeftFish;
const initialSandBackground = availableSandBackgroundImages[0] ?? null;
---

<div
  class:list={{
    "aquarium-backdrop": true,
    "has-fish-backgrounds": hasFishBackgroundImages,
    "has-sand-backgrounds": hasSandBackgroundImages,
  }}
  aria-hidden="true"
  data-aquarium-backdrop
>
  <div
    class="aquarium-scenery-layer aquarium-backdrop-left"
    data-aquarium-backdrop-left
    style={`background-image: url("${initialLeftScenery}")`}
  ></div>
  <div
    class="aquarium-scenery-layer aquarium-backdrop-right"
    data-aquarium-backdrop-right
    style={`background-image: url("${initialRightScenery}")`}
  ></div>
  {initialSandBackground && (
    <div
      class="aquarium-middle-sand-layer"
      data-aquarium-middle-sand
      style={`background-image: url("${initialSandBackground}")`}
    ></div>
  )}
  {initialLeftFish && (
    <div
      class="aquarium-fish-layer aquarium-fish-left"
      data-aquarium-fish-left
      style={`background-image: url("${initialLeftFish}")`}
    ></div>
  )}
  {initialRightFish && (
    <div
      class="aquarium-fish-layer aquarium-fish-right"
      data-aquarium-fish-right
      style={`background-image: url("${initialRightFish}")`}
    ></div>
  )}
</div>

<script is:inline define:vars={{
  availableSceneryImages,
  availableFishBackgroundImages,
  availableSandBackgroundImages,
}}>
  (() => {
    const backdrop = document.querySelector("[data-aquarium-backdrop]");
    const leftBackdrop = document.querySelector("[data-aquarium-backdrop-left]");
    const rightBackdrop = document.querySelector("[data-aquarium-backdrop-right]");
    const leftFishBackdrop = document.querySelector("[data-aquarium-fish-left]");
    const rightFishBackdrop = document.querySelector("[data-aquarium-fish-right]");
    const middleSandBackdrop = document.querySelector("[data-aquarium-middle-sand]");

    if (!backdrop || !leftBackdrop || !rightBackdrop) {
      return;
    }

    const selectPair = (images) => {
      const leftIndex = Math.floor(Math.random() * images.length);
      const rightIndex =
        images.length > 1
          ? (leftIndex + 1 + Math.floor(Math.random() * (images.length - 1))) % images.length
          : leftIndex;

      return [images[leftIndex], images[rightIndex]];
    };

    const randomizeOrientation = (element) => {
      element?.classList.toggle("is-mirrored", Math.random() < 0.5);
    };

    const [leftScenery, rightScenery] = selectPair(availableSceneryImages);
    leftBackdrop.style.backgroundImage = `url("${leftScenery}")`;
    rightBackdrop.style.backgroundImage = `url("${rightScenery}")`;
    randomizeOrientation(leftBackdrop);
    randomizeOrientation(rightBackdrop);

    if (leftFishBackdrop && availableFishBackgroundImages.length) {
      const [leftFish, rightFish] = selectPair(availableFishBackgroundImages);
      leftFishBackdrop.style.backgroundImage = `url("${leftFish}")`;
      randomizeOrientation(leftFishBackdrop);

      if (rightFishBackdrop && availableFishBackgroundImages.length > 1) {
        rightFishBackdrop.style.backgroundImage = `url("${rightFish}")`;
        randomizeOrientation(rightFishBackdrop);
      }
    }

    if (middleSandBackdrop && availableSandBackgroundImages.length) {
      const sandIndex = Math.floor(Math.random() * availableSandBackgroundImages.length);
      middleSandBackdrop.style.backgroundImage = `url("${availableSandBackgroundImages[sandIndex]}")`;
    }

    const updateArtworkSize = () => {
      const contentFrame = document.querySelector(".page-wrap");
      const footer = document.querySelector(".site-footer");
      const sideSpace = Math.max(
        0,
        contentFrame?.getBoundingClientRect().left ?? window.innerWidth / 2,
      );
      const artworkWidth = Math.min(900, Math.max(460, Math.round(sideSpace)));
      const footerClearance = Math.ceil(footer?.getBoundingClientRect().height ?? 0);
      backdrop.style.setProperty("--aquarium-art-width", `${artworkWidth}px`);
      backdrop.style.setProperty("--aquarium-footer-clearance", `${footerClearance}px`);
    };

    window.addEventListener("resize", updateArtworkSize, { passive: true });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", updateArtworkSize, { once: true });
    } else {
      updateArtworkSize();
    }

  })();
</script>
